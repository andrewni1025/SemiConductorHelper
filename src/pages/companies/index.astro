---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyCard from '../../components/CompanyCard.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('companies');
const base = import.meta.env.BASE_URL;

const grouped = new Map<string, typeof items>();
for (const it of items) {
  const seg = it.data.segment;
  if (!grouped.has(seg)) grouped.set(seg, []);
  grouped.get(seg)!.push(it);
}
const groups = Array.from(grouped.entries()).sort((a, b) => a[0].localeCompare(b[0], 'zh'));
---

<BaseLayout title="公司档案库" description="18 家全球关键半导体公司">
  <section class="max-w-5xl mx-auto px-5 sm:px-8 py-10">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">公司档案库</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400 max-w-2xl">
      覆盖海外算力、海外制造、海外存储、海外设备、中国制造/设备/EDA — 共 18 家关键公司的结构化档案。
    </p>

    {items.length === 0 ? (
      <div class="mt-8 p-6 rounded-lg border border-dashed border-slate-300 dark:border-slate-700 text-slate-500">
        还没有内容。在 <code>src/content/companies/</code> 下添加 .md / .mdx 文件即可。
      </div>
    ) : (
      <div class="mt-8 space-y-10">
        {groups.map(([segment, list]) => (
          <div>
            <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">
              {segment} <span class="text-sm text-slate-500 font-normal">· {list.length} 家</span>
            </h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {list.map((c) => (
                <CompanyCard
                  name={c.data.name}
                  nameEn={c.data.nameEn}
                  ticker={c.data.ticker}
                  country={c.data.country}
                  segment={c.data.segment}
                  moat={c.data.moat}
                  href={`${base}companies/${c.id}/`}
                />
              ))}
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
