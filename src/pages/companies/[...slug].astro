---
import DocLayout from '../../layouts/DocLayout.astro';
import CompanyHero from '../../components/CompanyHero.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('companies');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
const base = import.meta.env.BASE_URL;
const d = item.data;
---

<DocLayout
  title={d.name}
  description={d.nameEn}
  updated={d.updated}
  tags={d.tags}
  eyebrow={`公司档案 · ${d.segment}`}
  accent="amber"
  headings={headings}
  body={item.body ?? ''}
  showHero={false}
  breadcrumb={[
    { label: '首页', href: base },
    { label: '公司档案', href: `${base}companies/` },
    { label: d.name },
  ]}
>
  <CompanyHero
    slug={item.id}
    name={d.name}
    nameEn={d.nameEn}
    ticker={d.ticker}
    country={d.country}
    segment={d.segment}
    moat={d.moat}
    keyPeople={d.keyPeople}
    customers={d.customers}
    competitors={d.competitors}
    website={d.website}
    tags={d.tags}
  />

  {(d.keyTech || d.customers || d.competitors) && (
    <section class="not-prose mt-2 mb-8 grid md:grid-cols-3 gap-3">
      {d.keyTech && d.keyTech.length > 0 && (
        <div class="company-meta-card">
          <p class="company-meta-label">关键技术</p>
          <div class="flex flex-wrap gap-1.5">
            {d.keyTech.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      )}
      {d.customers && d.customers.length > 0 && (
        <div class="company-meta-card">
          <p class="company-meta-label">主要客户</p>
          <p class="company-meta-text">{d.customers.join('、')}</p>
        </div>
      )}
      {d.competitors && d.competitors.length > 0 && (
        <div class="company-meta-card">
          <p class="company-meta-label">主要竞争对手</p>
          <p class="company-meta-text">{d.competitors.join('、')}</p>
        </div>
      )}
    </section>
  )}

  <Content />
</DocLayout>
