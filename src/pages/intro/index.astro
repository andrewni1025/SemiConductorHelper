---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const items = (await getCollection('intro')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="入门地图" description="给完全外行的朋友讲清楚半导体是什么">
  <section class="max-w-4xl mx-auto px-5 sm:px-8 py-10">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">入门地图</h1>
    <p class="mt-3 text-slate-600 dark:text-slate-400">
      给完全外行的朋友讲清楚半导体是什么、芯片是怎么造出来的、上下游是怎么连接的。
    </p>

    {items.length === 0 ? (
      <div class="mt-8 p-6 rounded-lg border border-dashed border-slate-300 dark:border-slate-700 text-slate-500">
        还没有内容。在 <code>src/content/intro/</code> 下添加 .md / .mdx 文件即可。
      </div>
    ) : (
      <ul class="mt-8 space-y-3">
        {items.map((item) => (
          <li>
            <a href={`${base}intro/${item.id}/`} class="card block !no-underline group">
              <h2 class="text-lg font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300">
                {item.data.title}
              </h2>
              {item.data.description && (
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{item.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
