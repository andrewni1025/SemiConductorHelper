---
import DocLayout from '../../layouts/DocLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('segments');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
const base = import.meta.env.BASE_URL;
---

<DocLayout
  title={item.data.title}
  description={item.data.summary}
  updated={item.data.updated}
  eyebrow="产业链词典"
  accent="emerald"
  headings={headings}
  body={item.body ?? ''}
  breadcrumb={[
    { label: '首页', href: base },
    { label: '产业链', href: `${base}segments/` },
    { label: item.data.title },
  ]}
>
  {(item.data.moat || item.data.cyclicality || item.data.keyTech) && (
    <section class="not-prose mb-8 grid md:grid-cols-2 gap-3">
      {item.data.moat && (
        <div class="company-meta-card">
          <p class="company-meta-label">护城河</p>
          <p class="company-meta-text">{item.data.moat}</p>
        </div>
      )}
      {item.data.cyclicality && (
        <div class="company-meta-card">
          <p class="company-meta-label">周期特征</p>
          <p class="company-meta-text">{item.data.cyclicality}</p>
        </div>
      )}
      {item.data.keyTech && item.data.keyTech.length > 0 && (
        <div class="company-meta-card md:col-span-2">
          <p class="company-meta-label">关键技术 / 工艺</p>
          <div class="flex flex-wrap gap-1.5">
            {item.data.keyTech.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
      )}
      {item.data.representativeCompanies && item.data.representativeCompanies.length > 0 && (
        <div class="company-meta-card md:col-span-2">
          <p class="company-meta-label">代表公司</p>
          <p class="company-meta-text">{item.data.representativeCompanies.join('、')}</p>
        </div>
      )}
    </section>
  )}

  <Content />
</DocLayout>
