---
import DocLayout from '../../layouts/DocLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('segments');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const base = import.meta.env.BASE_URL;
---

<DocLayout
  title={item.data.title}
  description={item.data.summary}
  updated={item.data.updated}
  breadcrumb={[
    { label: '首页', href: base },
    { label: '产业链', href: `${base}segments/` },
    { label: item.data.title },
  ]}
>
  {(item.data.moat || item.data.cyclicality || item.data.keyTech) && (
    <div class="not-prose mb-6 p-4 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900">
      <dl class="grid sm:grid-cols-2 gap-3 text-sm">
        {item.data.moat && (
          <div>
            <dt class="text-slate-500">护城河</dt>
            <dd class="text-slate-800 dark:text-slate-200 mt-0.5">{item.data.moat}</dd>
          </div>
        )}
        {item.data.cyclicality && (
          <div>
            <dt class="text-slate-500">周期特征</dt>
            <dd class="text-slate-800 dark:text-slate-200 mt-0.5">{item.data.cyclicality}</dd>
          </div>
        )}
        {item.data.keyTech && item.data.keyTech.length > 0 && (
          <div class="sm:col-span-2">
            <dt class="text-slate-500">关键技术 / 工艺</dt>
            <dd class="mt-1 flex flex-wrap gap-1.5">
              {item.data.keyTech.map((t) => <span class="tag">{t}</span>)}
            </dd>
          </div>
        )}
        {item.data.representativeCompanies && item.data.representativeCompanies.length > 0 && (
          <div class="sm:col-span-2">
            <dt class="text-slate-500">代表公司</dt>
            <dd class="text-slate-800 dark:text-slate-200 mt-0.5">
              {item.data.representativeCompanies.join('、')}
            </dd>
          </div>
        )}
      </dl>
    </div>
  )}

  <Content />
</DocLayout>
