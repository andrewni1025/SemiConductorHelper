---
import DocLayout from '../../layouts/DocLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('weekly');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
const base = import.meta.env.BASE_URL;
const d = item.data;
const fmt = (date: Date) => date.toISOString().slice(0, 10);
---

<DocLayout
  title={d.title}
  description={`覆盖政策 / 财报 / AI 链条 / 技术发布`}
  eyebrow="时事周报"
  accent="indigo"
  badge={`${fmt(d.weekStart)} → ${fmt(d.weekEnd)}`}
  headings={headings}
  body={item.body ?? ''}
  breadcrumb={[
    { label: '首页', href: base },
    { label: '时事周报', href: `${base}weekly/` },
    { label: d.title },
  ]}
>
  {d.highlights && d.highlights.length > 0 && (
    <aside class="callout callout-insight not-prose my-6">
      <header class="callout-header">
        <span class="callout-icon" aria-hidden="true">🎯</span>
        <span class="callout-title">本周要点</span>
      </header>
      <div class="callout-body">
        <ul>
          {d.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </div>
    </aside>
  )}

  <Content />

  {d.sources && d.sources.length > 0 && (
    <section class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2>来源</h2>
      <ul>
        {d.sources.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener">{s.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</DocLayout>
