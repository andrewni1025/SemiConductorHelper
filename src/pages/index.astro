---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

type SnapshotItem = {
  ticker: string;
  name: string;
  price: number;
  previousClose: number;
};

type StockSnapshot = {
  date: string;
  items: SnapshotItem[];
};

const snapshotFiles = import.meta.glob<StockSnapshot>('../../data/snapshots/*.json', {
  eager: true,
  import: 'default',
});
const snapshot = Object.values(snapshotFiles).sort(
  (a, b) => +new Date(b.date) - +new Date(a.date),
)[0];

if (!snapshot) {
  throw new Error('No stock snapshot found in data/snapshots.');
}

const intros = (await getCollection('intro')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const segments = (await getCollection('segments')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const companies = await getCollection('companies');
const techs = (await getCollection('tech')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const weekly = (await getCollection('weekly')).sort(
  (a, b) => +new Date(b.data.weekStart) - +new Date(a.data.weekStart),
);
const latestWeekly = weekly[0];

const formatPercent = (value: number) => `${value >= 0 ? '+' : ''}${value.toFixed(1)}%`;
const topMovers = snapshot.items
  .map((item) => ({
    ticker: item.ticker,
    name: item.name,
    changePct: ((item.price - item.previousClose) / item.previousClose) * 100,
  }))
  .filter((item) => Number.isFinite(item.changePct))
  .sort((a, b) => b.changePct - a.changePct)
  .slice(0, 6)
  .map((item) => ({
    ...item,
    barHeight: `${Math.min(92, Math.max(24, item.changePct * 5.2))}%`,
  }));

const headlineMovers = topMovers.slice(0, 3);

const homeStats = [
  { label: '覆盖公司', value: companies.length, suffix: '家', note: '全球核心标的' },
  { label: '产业链环节', value: segments.length, suffix: '个', note: '上游 → 下游' },
  { label: '最新快照', value: snapshot.date, suffix: '', note: '股价 / 估值' },
  { label: '作者', value: 'Andrew', suffix: '', note: '个人研究地图' },
];

const sections = [
  {
    title: '入门地图',
    desc: '5 分钟看懂半导体是什么、上下游怎么连',
    href: `${base}intro/`,
    count: intros.length,
    color: 'from-brand-500 to-brand-700',
    accent: 'cyan',
    kicker: 'Start Here',
    cta: '从零开始',
  },
  {
    title: '产业链词典',
    desc: 'EDA / Fabless / Foundry / 设备 / 材料 / 存储 / 封装 / 下游',
    href: `${base}segments/`,
    count: segments.length,
    color: 'from-emerald-500 to-emerald-700',
    accent: 'emerald',
    kicker: 'Supply Chain',
    cta: '看上下游',
  },
  {
    title: '公司档案库',
    desc: '18 家全球关键公司：业务、护城河、关键人物、最新动态',
    href: `${base}companies/`,
    count: companies.length,
    color: 'from-amber-500 to-amber-700',
    accent: 'amber',
    kicker: 'Company Radar',
    cta: '研究公司',
  },
  {
    title: '技术 & 周期',
    desc: '制程、先进封装、HBM、SiC/GaN、半导体周期与估值方法',
    href: `${base}tech/`,
    count: techs.length,
    color: 'from-rose-500 to-rose-700',
    accent: 'rose',
    kicker: 'Tech Routes',
    cta: '理解技术',
  },
  {
    title: '时事周报',
    desc: '政策、财报、AI 链条、关键事件追踪（按需更新）',
    href: `${base}weekly/`,
    count: weekly.length,
    color: 'from-indigo-500 to-indigo-700',
    accent: 'indigo',
    kicker: 'Weekly Brief',
    cta: '追踪时事',
  },
];

const rallyPaths = [
  {
    eyebrow: 'AI 算力',
    title: '先看谁在把需求变收入',
    desc: 'NVIDIA、AMD、ASIC、云厂商 CAPEX，是这轮行情的第一条主线。',
    href: `${base}segments/fabless/`,
    accent: 'cyan',
    signal: '01',
  },
  {
    eyebrow: 'HBM / CoWoS',
    title: '瓶颈在哪里，溢价就在哪里',
    desc: '先进封装、HBM、台积电产能，是 AI 芯片能否交付的关键约束。',
    href: `${base}tech/cowos/`,
    accent: 'emerald',
    signal: '02',
  },
  {
    eyebrow: '设备 / 国产替代',
    title: '卖铲子的人也在重估',
    desc: '光刻、刻蚀、薄膜、量测与国产设备，决定制造能力的天花板。',
    href: `${base}segments/equipment/`,
    accent: 'amber',
    signal: '03',
  },
  {
    eyebrow: '周期 / 估值',
    title: '暴涨之后更要看位置',
    desc: '用库存、资本开支、盈利弹性和估值框架判断行情处在什么阶段。',
    href: `${base}tech/cycle/`,
    accent: 'rose',
    signal: '04',
  },
];

const workflow = [
  {
    step: '01',
    title: '先建立全局地图',
    desc: '从入门地图理解一颗芯片怎么来、为什么重要。',
    href: `${base}intro/`,
  },
  {
    step: '02',
    title: '再拆产业链位置',
    desc: '判断谁卖铲子、谁制造、谁设计、谁被下游需求拉动。',
    href: `${base}segments/`,
  },
  {
    step: '03',
    title: '最后落到公司与周期',
    desc: '把护城河、估值、财报、政策和技术路线放到同一张图里看。',
    href: latestWeekly ? `${base}weekly/${latestWeekly.id}/` : `${base}weekly/`,
  },
];
---

<BaseLayout>
  <section class="home-hero relative overflow-hidden bg-[#eefcff] dark:bg-[#02040a]">
    <div class="absolute inset-0 hero-glow pointer-events-none"></div>
    <div class="absolute inset-0 hero-grid pointer-events-none"></div>
    <div class="absolute inset-0 hero-noise pointer-events-none"></div>
    <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-cyan-300/60 to-transparent dark:via-cyan-300/30"></div>

    <div class="relative max-w-6xl mx-auto px-5 sm:px-8 py-16 sm:py-24 lg:py-28 grid lg:grid-cols-[1.03fr_0.97fr] gap-12 items-center">
      <div>
        <div class="home-kicker-row">
          <div class="inline-flex items-center gap-2 text-xs font-mono tracking-[0.2em] text-brand-600 dark:text-brand-300 uppercase">
            <span class="pulse-dot"></span>
            <span>AI Chips Rally · Semiconductor Field Guide</span>
          </div>
          <div class="home-author-pill">
            Curated by <strong>Andrew</strong>
          </div>
        </div>

        <h1 class="mt-5 text-4xl sm:text-6xl lg:text-7xl font-black leading-[1.02] tracking-tight">
          <span class="hero-title-gradient">芯片狂潮</span>
          <br />
          <span class="text-slate-950 dark:text-white">正在重定价世界</span>
        </h1>

        <p class="mt-5 text-xl sm:text-2xl text-brand-800 dark:text-brand-200 font-semibold">
          别只看涨幅，先看懂谁在印钱、谁在卖铲子。
        </p>

        <p class="mt-6 text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
          这轮暴涨背后，是 AI 算力、HBM、CoWoS、设备国产化、存储周期一起点火。
          这里把行情、公司、产业链和技术路线拆开给你看。
        </p>

        <div class="mt-7 flex flex-wrap gap-2">
          {headlineMovers.map((mover) => (
            <span class="surge-pill">
              <span class="text-slate-500 dark:text-slate-400">{mover.ticker}</span>
              <strong>{formatPercent(mover.changePct)}</strong>
            </span>
          ))}
        </div>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={`${base}weekly/`}
            class="btn-glow inline-flex items-center gap-2 px-6 py-3 rounded-lg
                   border border-white/70 dark:border-cyan-100/70
                   bg-gradient-to-r from-cyan-300 via-emerald-300 to-amber-200
                   dark:from-cyan-200 dark:via-emerald-200 dark:to-amber-100
                   hover:from-cyan-200 hover:via-emerald-200 hover:to-amber-100
                   !text-slate-950 dark:!text-slate-950 font-black !no-underline transition"
          >
            看本周行情主线 →
          </a>
          <a
            href={`${base}companies/`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg
                   border border-slate-300/80 dark:border-cyan-300/25
                   bg-white/55 dark:bg-white/[0.03]
                   text-slate-800 dark:text-slate-100
                   hover:border-brand-400 dark:hover:border-brand-400
                   hover:text-brand-700 dark:hover:text-brand-200
                   !no-underline transition backdrop-blur"
          >
            打开公司地图 →
          </a>
        </div>

        <div class="home-stat-strip">
          {homeStats.map((stat) => (
            <div class="home-stat">
              <span>{stat.label}</span>
              <strong>{stat.value}{stat.suffix}</strong>
              <em>{stat.note}</em>
            </div>
          ))}
        </div>
      </div>

      <aside class="market-surge-card">
        <div class="market-corner-chip" aria-hidden="true">AI</div>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-xs font-mono tracking-[0.2em] text-brand-700 dark:text-brand-300 uppercase">
              Market Shockwave
            </p>
            <h2 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">
              芯片股暴涨雷达
            </h2>
          </div>
          <div class="text-right">
            <p class="text-xs text-slate-500 dark:text-slate-400">快照</p>
            <p class="font-mono text-sm text-slate-900 dark:text-brand-100">{snapshot.date}</p>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-3 gap-2">
          {headlineMovers.map((mover) => (
            <div class="rounded-lg border border-cyan-400/20 bg-white/55 dark:bg-slate-950/50 px-3 py-2">
              <p class="font-mono text-xs text-slate-500 dark:text-slate-400">{mover.ticker}</p>
              <p class="text-xl font-black text-emerald-600 dark:text-emerald-300">
                {formatPercent(mover.changePct)}
              </p>
            </div>
          ))}
        </div>

        <div class="market-panel mt-5">
          <svg class="w-full h-44" viewBox="0 0 640 220" role="img" aria-label="芯片股上涨趋势示意图">
            <defs>
              <linearGradient id="surgeArea" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="#22d3ee" stop-opacity="0.45" />
                <stop offset="100%" stop-color="#22d3ee" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="surgeStroke" x1="0" x2="1" y1="0" y2="0">
                <stop offset="0%" stop-color="#22d3ee" />
                <stop offset="52%" stop-color="#a7f3d0" />
                <stop offset="100%" stop-color="#facc15" />
              </linearGradient>
            </defs>
            <path d="M20 178 C92 168 120 138 180 148 C238 158 272 104 334 112 C406 122 430 62 498 70 C552 76 574 40 620 28 L620 210 L20 210 Z" fill="url(#surgeArea)" />
            <path class="rally-line" d="M20 178 C92 168 120 138 180 148 C238 158 272 104 334 112 C406 122 430 62 498 70 C552 76 574 40 620 28" fill="none" stroke="url(#surgeStroke)" stroke-width="6" stroke-linecap="round" />
            <g fill="#facc15">
              <circle cx="498" cy="70" r="5" />
              <circle cx="620" cy="28" r="6" />
            </g>
          </svg>

          <div class="grid grid-cols-6 gap-3 h-28 items-end">
            {topMovers.map((mover) => (
              <div class="flex flex-col items-center gap-2 min-w-0">
                <div class="surge-bar-track">
                  <span class="surge-bar-fill" style={`height: ${mover.barHeight};`}></span>
                </div>
                <div class="text-center min-w-0">
                  <p class="truncate font-mono text-[10px] text-slate-500 dark:text-slate-400 w-full">
                    {mover.ticker}
                  </p>
                  <p class="font-mono text-[11px] font-bold text-emerald-600 dark:text-emerald-300">
                    {formatPercent(mover.changePct)}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          用站内股价快照生成的视觉化行情图，不是交易信号；真正要看的是涨幅背后的订单、产能、技术瓶颈和周期位置。
        </p>
      </aside>
    </div>
  </section>

  <section class="home-band max-w-6xl mx-auto px-5 sm:px-8 py-10 sm:py-14">
    <div class="home-section-head">
      <p>MARKET THREADS</p>
      <h2>先抓住这波行情的四条主线</h2>
    </div>
    <div class="home-rally-grid">
      {rallyPaths.map((path) => (
        <a href={path.href} class={`home-rally-card home-rally-${path.accent} group !no-underline`}>
          <span class="home-card-index">{path.signal}</span>
          <p class="home-card-eyebrow">{path.eyebrow}</p>
          <h3>{path.title}</h3>
          <p>{path.desc}</p>
          <span class="home-card-arrow">进入主线 →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-feature-section max-w-6xl mx-auto px-5 sm:px-8 py-8 sm:py-12">
    <div class="home-section-head">
      <p>RESEARCH MODULES</p>
      <h2>从暴涨主线拆到长期认知</h2>
      <span>不是追热点，而是把公司、技术、周期、政策放进同一张地图里。</span>
    </div>
    <div class="home-feature-grid">
      {sections.map((s) => (
        <a href={s.href} class={`home-feature-card home-feature-${s.accent} group !no-underline`}>
          <div class="home-feature-orb">
            <span>{s.count || '·'}</span>
          </div>
          <div>
            <p class="home-card-eyebrow">{s.kicker}</p>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
          <span class="home-card-arrow">{s.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-workflow-section max-w-6xl mx-auto px-5 sm:px-8 pb-16">
    <div class="home-workflow-card">
      <div class="home-workflow-copy">
        <p class="home-card-eyebrow">HOW TO USE</p>
        <h2>给自己和朋友看的半导体研究路径</h2>
        <p>
          这不是实时交易面板，而是一张由 Andrew 维护的行业认知地图：
          先搭框架，再看产业位置，最后落到公司和周期。
        </p>
      </div>
      <div class="home-workflow-grid">
        {workflow.map((item) => (
          <a href={item.href} class="home-workflow-step !no-underline">
            <span>{item.step}</span>
            <strong>{item.title}</strong>
            <em>{item.desc}</em>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
