---
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Accent = 'cyan' | 'emerald' | 'amber' | 'rose' | 'indigo';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  updated?: Date;
  tags?: string[];
  eyebrow?: string;
  breadcrumb?: { label: string; href?: string }[];
  headings?: Heading[];
  body?: string;
  accent?: Accent;
  /** 文章 hero 内额外的右上角小角标，比如周报的日期范围 */
  badge?: string;
  /** 是否在 H1 之前再渲染一段大块 hero（默认 true） */
  showHero?: boolean;
}

const {
  title,
  description,
  updated,
  tags,
  eyebrow,
  breadcrumb = [],
  headings = [],
  body = '',
  accent = 'cyan',
  badge,
  showHero = true,
} = Astro.props as Props;

const accentClass = `accent-${accent}`;

// 粗略阅读时长：中文按 ~600 字/分钟。MDX 中混杂 JSX 不准但够用。
const readingMinutes = body ? Math.max(1, Math.round(body.length / 600)) : null;
---

<BaseLayout title={title} description={description}>
  <ReadingProgress />

  <div class={`doc-page ${accentClass}`}>
    <article class="doc-shell">
      {breadcrumb.length > 0 && (
        <nav class="doc-breadcrumb" aria-label="breadcrumb">
          {breadcrumb.map((b, i) => (
            <span>
              {b.href ? <a href={b.href}>{b.label}</a> : <span class="doc-breadcrumb-current">{b.label}</span>}
              {i < breadcrumb.length - 1 && <span class="doc-breadcrumb-sep">›</span>}
            </span>
          ))}
        </nav>
      )}

      {showHero && (
        <header class="doc-hero">
          <div class="doc-hero-meta">
            {eyebrow && (
              <span class="doc-eyebrow">
                <span class="pulse-dot"></span>
                {eyebrow}
              </span>
            )}
            {badge && <span class="doc-badge">{badge}</span>}
          </div>

          <h1 class="doc-title">{title}</h1>
          {description && <p class="doc-subtitle">{description}</p>}

          <div class="doc-hero-info">
            {updated && (
              <span class="doc-info-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                更新于 {updated.toISOString().slice(0, 10)}
              </span>
            )}
            {readingMinutes !== null && (
              <span class="doc-info-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                约 {readingMinutes} 分钟
              </span>
            )}
            {tags && tags.length > 0 && (
              <span class="doc-info-tags">
                {tags.map((t) => <span class="tag">{t}</span>)}
              </span>
            )}
          </div>

          <div class="doc-hero-divider" aria-hidden="true"></div>
        </header>
      )}

      <div class="doc-body">
        <div class="doc-content prose-doc">
          <slot />
        </div>
        <TableOfContents headings={headings} />
      </div>
    </article>
  </div>
</BaseLayout>
