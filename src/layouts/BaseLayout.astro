---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = '半导体行业认知手册', description = '上下游 · 公司 · 技术路线 · 投资周期' } = Astro.props;
const fullTitle = title === '半导体行业认知手册' ? title : `${title} · 半导体行业认知手册`;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{fullTitle}</title>
    <script is:inline>
      // 在内容渲染前应用主题，避免闪烁
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <NavBar />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-800 py-6 text-center text-sm text-slate-500">
      <p>半导体行业认知手册 · 内容仅供学习参考，不构成投资建议</p>
      <p class="mt-1">由 Astro + Copilot CLI 协作维护</p>
    </footer>

    <script>
      // 仅在页面含 mermaid 代码块时动态加载 mermaid，避免拖慢其他页面
      // Astro 的 Shiki 把 ```mermaid 渲染成 <pre data-language="mermaid">，所以按 data-language 选择
      const mermaidPres = document.querySelectorAll('pre[data-language="mermaid"]');
      if (mermaidPres.length > 0) {
        const isDark = document.documentElement.classList.contains('dark');
        const { default: mermaid } = await import('mermaid');
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'neutral',
          securityLevel: 'loose',
          fontFamily: 'inherit',
        });
        for (const [i, pre] of mermaidPres.entries()) {
          const code = (pre.textContent ?? '').trim();
          try {
            const { svg } = await mermaid.render(`mermaid-${i}-${Date.now()}`, code);
            const wrap = document.createElement('div');
            wrap.className = 'mermaid-diagram my-6 overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-800 p-4 bg-white dark:bg-slate-900';
            wrap.innerHTML = svg;
            pre.replaceWith(wrap);
          } catch (err) {
            console.warn('Mermaid render failed:', err);
            const errEl = document.createElement('div');
            errEl.className = 'my-6 p-4 rounded-lg border border-rose-300 bg-rose-50 text-rose-800 text-sm';
            errEl.textContent = 'Mermaid 图渲染失败：' + (err?.message ?? String(err));
            pre.replaceWith(errEl);
          }
        }
      }
    </script>
  </body>
</html>
