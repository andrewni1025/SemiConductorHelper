---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteName = '半导体深度地图';
const { title = siteName, description = '上下游 · 公司 · 技术路线 · 投资周期' } = Astro.props;
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{fullTitle}</title>
    <script is:inline>
      // 在内容渲染前应用主题，避免闪烁
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <NavBar />
    <main class="flex-1 w-full">
      <slot />
    </main>
    <footer class="border-t border-slate-200 dark:border-slate-800 py-6 text-center text-sm text-slate-500">
      <p>半导体深度地图 · 内容仅供学习参考，不构成投资建议</p>
      <p class="mt-1">由 Astro + Copilot CLI 协作维护</p>
    </footer>

  </body>
</html>
