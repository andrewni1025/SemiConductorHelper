---
const base = import.meta.env.BASE_URL;

const lanes = [
  {
    label: '上游',
    title: '工具与原料',
    accent: 'from-cyan-400 to-blue-500',
    items: [
      { name: 'EDA / IP', desc: '芯片设计软件与可复用电路模块', href: `${base}segments/eda/`, tag: '卡脖子 ★★★★★' },
      { name: '设备', desc: '光刻、刻蚀、薄膜、量测、检测', href: `${base}segments/equipment/`, tag: '寡头垄断' },
      { name: '材料', desc: '硅片、光刻胶、电子气体、靶材', href: `${base}segments/materials/`, tag: '隐形刚需' },
    ],
  },
  {
    label: '中游',
    title: '设计、制造与封测',
    accent: 'from-emerald-400 to-teal-500',
    items: [
      { name: 'Fabless', desc: 'NVIDIA / AMD 这类只设计不制造', href: `${base}segments/fabless/`, tag: '弹性最大' },
      { name: 'Foundry / IDM', desc: 'TSMC / Samsung / Intel / SMIC', href: `${base}segments/foundry/`, tag: '资本密集' },
      { name: '存储 + 封测', desc: 'HBM、DRAM、OSAT、先进封装', href: `${base}segments/memory/`, tag: 'AI 瓶颈' },
    ],
  },
  {
    label: '下游',
    title: '终端需求',
    accent: 'from-amber-300 to-orange-500',
    items: [
      { name: 'AI / 数据中心', desc: '云厂商 CapEx 驱动 GPU、HBM、网络', href: `${base}segments/downstream/`, tag: '当前主线' },
      { name: '汽车 / 工业', desc: 'SiC、MCU、CIS、模拟与功率器件', href: `${base}tech/sic-gan/`, tag: '长周期' },
      { name: '手机 / PC / IoT', desc: '消费电子决定库存小周期', href: `${base}tech/cycle/`, tag: '复苏观察' },
    ],
  },
];
---

<section class="not-prose my-8 rounded-3xl border border-cyan-400/20 bg-white/85 p-4 shadow-xl shadow-cyan-900/5 backdrop-blur dark:bg-slate-950/70 dark:shadow-cyan-500/10 sm:p-6">
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand-600 dark:text-brand-300">Supply Chain Map</p>
      <h3 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">一张图看懂：谁卡住谁，钱流向哪里</h3>
    </div>
    <p class="max-w-sm text-sm leading-relaxed text-slate-500 dark:text-slate-400">
      越上游越垄断，越下游越分散；AI 周期把 Fabless、HBM、CoWoS 和先进制程连成一条高压主线。
    </p>
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-3">
    {lanes.map((lane, index) => (
      <div class="relative rounded-2xl border border-slate-200 bg-slate-50/80 p-4 dark:border-slate-800 dark:bg-slate-900/70">
        {index < lanes.length - 1 && (
          <div class="pointer-events-none absolute -right-5 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-cyan-300/30 bg-white text-cyan-600 shadow-lg shadow-cyan-900/10 dark:bg-slate-950 dark:text-cyan-300 lg:flex">
            →
          </div>
        )}
        <div class={`h-1.5 rounded-full bg-gradient-to-r ${lane.accent}`}></div>
        <div class="mt-4 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 dark:text-slate-400">{lane.label}</p>
            <h4 class="text-lg font-bold text-slate-950 dark:text-white">{lane.title}</h4>
          </div>
          <span class="rounded-full border border-cyan-400/25 px-2.5 py-1 font-mono text-xs text-brand-700 dark:text-brand-200">
            0{index + 1}
          </span>
        </div>

        <div class="mt-4 space-y-3">
          {lane.items.map((item) => (
            <a href={item.href} class="group block rounded-xl border border-white bg-white p-3 !no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-950/80 dark:hover:border-brand-500">
              <div class="flex items-center justify-between gap-3">
                <strong class="text-slate-950 group-hover:text-brand-700 dark:text-white dark:group-hover:text-brand-200">
                  {item.name}
                </strong>
                <span class="shrink-0 rounded-full bg-cyan-50 px-2 py-0.5 text-[11px] font-semibold text-cyan-700 dark:bg-cyan-950/50 dark:text-cyan-200">
                  {item.tag}
                </span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-5 rounded-2xl border border-amber-300/30 bg-gradient-to-r from-cyan-50 via-emerald-50 to-amber-50 p-4 dark:from-cyan-950/30 dark:via-emerald-950/20 dark:to-amber-950/20">
    <p class="font-semibold text-slate-950 dark:text-white">AI 链条的最短路径</p>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      {['EDA / 设备 / 材料', 'TSMC 先进制程', 'CoWoS + HBM', 'NVIDIA / ASIC', '云厂商 CapEx'].map((item, index) => (
        <>
          <span class="rounded-full border border-cyan-400/20 bg-white px-3 py-1.5 text-slate-700 dark:bg-slate-950/70 dark:text-slate-200">{item}</span>
          {index < 4 && <span class="text-brand-500">→</span>}
        </>
      ))}
    </div>
  </div>
</section>
