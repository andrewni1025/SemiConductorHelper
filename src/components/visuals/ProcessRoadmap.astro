---
const nodes = [
  { node: '28nm', year: '2011', tech: 'Planar HKMG', note: '成熟节点现金牛' },
  { node: '16/14nm', year: '2014–15', tech: 'FinFET', note: '3D 沟道止住漏电' },
  { node: 'N7', year: '2018', tech: 'EUV 首发', note: 'TSMC 拉开差距' },
  { node: 'N5', year: '2020', tech: 'EUV 全面化', note: 'AI GPU 主力前代' },
  { node: 'N3', year: '2023', tech: 'FinFET 终结代', note: 'Blackwell 时代' },
  { node: 'N2', year: '2025', tech: 'GAA Nanosheet', note: '晶体管结构换代' },
  { node: 'A16', year: '2026', tech: 'GAA + BSPDN', note: '背面供电' },
  { node: 'A14', year: '2027–28', tech: 'High-NA EUV', note: '下一轮光刻平台' },
];
---

<section class="not-prose my-8 rounded-3xl border border-cyan-400/20 bg-white p-5 shadow-xl shadow-cyan-900/5 dark:bg-slate-950 sm:p-6">
  <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand-600 dark:text-brand-300">Process Roadmap</p>
  <h3 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">制程演进不是数字变小，而是三次技术接力</h3>

  <div class="mt-6 overflow-x-auto pb-3">
    <div class="flex min-w-[920px] items-stretch gap-3">
      {nodes.map((item, index) => (
        <div class="relative flex w-32 shrink-0 flex-col rounded-2xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/70">
          {index < nodes.length - 1 && <div class="absolute -right-3 top-10 z-10 h-0.5 w-3 bg-cyan-400"></div>}
          <p class="font-mono text-xs text-slate-500 dark:text-slate-400">{item.year}</p>
          <p class="mt-2 text-2xl font-black text-slate-950 dark:text-white">{item.node}</p>
          <p class="mt-2 rounded-lg bg-cyan-50 px-2 py-1 text-xs font-bold text-cyan-800 dark:bg-cyan-950/50 dark:text-cyan-100">{item.tech}</p>
          <p class="mt-3 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{item.note}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-4 grid gap-3 md:grid-cols-3">
    <div class="rounded-2xl border border-cyan-300/25 bg-cyan-50 p-4 dark:bg-cyan-950/25">
      <p class="font-bold text-cyan-900 dark:text-cyan-100">Planar → FinFET</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">解决漏电和功耗失控。</p>
    </div>
    <div class="rounded-2xl border border-emerald-300/25 bg-emerald-50 p-4 dark:bg-emerald-950/25">
      <p class="font-bold text-emerald-900 dark:text-emerald-100">DUV → EUV</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">把复杂多重曝光简化，良率和成本成为分水岭。</p>
    </div>
    <div class="rounded-2xl border border-amber-300/25 bg-amber-50 p-4 dark:bg-amber-950/25">
      <p class="font-bold text-amber-900 dark:text-amber-100">FinFET → GAA + 背面供电</p>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">继续榨能效，但单晶体管成本不再线性下降。</p>
    </div>
  </div>
</section>
