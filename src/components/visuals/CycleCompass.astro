---
const groups = [
  { title: '领先 6–12 个月', items: ['设备 B2B', '产能利用率', 'DRAM/NAND 现货价', 'Wafer Starts'], color: 'cyan' },
  { title: '同步', items: ['营收 YoY', '毛利与产品组合', '渠道库存 DOI'], color: 'emerald' },
  { title: '滞后 6–12 个月', items: ['CapEx 计划', '人员 / 招聘变动'], color: 'amber' },
];

const cycle = ['复苏', '扩张', '过热', '下行'];
---

<section class="not-prose my-8 rounded-3xl border border-cyan-400/20 bg-white p-5 shadow-xl shadow-cyan-900/5 dark:bg-slate-950 sm:p-6">
  <div class="grid gap-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
    <div class="relative mx-auto aspect-square w-full max-w-sm rounded-full border border-cyan-300/20 bg-gradient-to-br from-cyan-50 via-white to-amber-50 p-8 dark:from-cyan-950/30 dark:via-slate-950 dark:to-amber-950/20">
      <div class="absolute inset-8 rounded-full border border-dashed border-cyan-400/30"></div>
      <div class="absolute inset-20 rounded-full border border-emerald-400/25"></div>
      <div class="relative flex h-full items-center justify-center rounded-full bg-slate-950 text-center text-white shadow-2xl shadow-cyan-900/20">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-cyan-300">Cycle</p>
          <p class="mt-2 text-3xl font-black">周期罗盘</p>
          <p class="mt-2 text-sm text-slate-300">不是预测，是观察</p>
        </div>
      </div>
      {cycle.map((phase, index) => (
        <div class={`absolute rounded-full border border-white bg-white px-3 py-1.5 text-sm font-bold text-slate-800 shadow-md dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 ${index === 0 ? 'bottom-5 left-1/2 -translate-x-1/2' : index === 1 ? 'right-4 top-1/2 -translate-y-1/2' : index === 2 ? 'left-1/2 top-5 -translate-x-1/2' : 'left-4 top-1/2 -translate-y-1/2'}`}>
          {phase}
        </div>
      ))}
    </div>

    <div>
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-brand-600 dark:text-brand-300">Indicator Stack</p>
      <h3 class="mt-2 text-2xl font-black text-slate-950 dark:text-white">8 个指标按时间顺序看</h3>
      <div class="mt-5 grid gap-3">
        {groups.map((group, index) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/70">
            <div class="flex items-center justify-between gap-3">
              <h4 class="font-bold text-slate-950 dark:text-white">{group.title}</h4>
              {index < groups.length - 1 && <span class="hidden text-brand-500 sm:block">→</span>}
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-full border border-cyan-300/20 bg-white px-3 py-1.5 text-sm text-slate-700 dark:bg-slate-950 dark:text-slate-200">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-4 rounded-2xl border border-amber-300/30 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900 dark:bg-amber-950/20 dark:text-amber-100">
        CapEx 往往是滞后指标：所有人都追加产能时，未来过剩的种子也在被种下。
      </p>
    </div>
  </div>
</section>
