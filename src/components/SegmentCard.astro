---
interface Props {
  title: string;
  summary: string;
  representativeCompanies?: string[];
  href: string;
}

const { title, summary, representativeCompanies, href } = Astro.props;
---

<a href={href} class="card block !no-underline group">
  <h3 class="text-lg font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300">
    {title}
  </h3>
  <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 line-clamp-3">
    {summary}
  </p>
  {representativeCompanies && representativeCompanies.length > 0 && (
    <p class="mt-3 text-xs text-slate-500">
      代表公司：{representativeCompanies.slice(0, 4).join('、')}
      {representativeCompanies.length > 4 && ' …'}
    </p>
  )}
</a>
