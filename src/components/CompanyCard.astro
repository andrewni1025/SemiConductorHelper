---
import {
  getStock,
  changePct,
  rangePosition,
  formatCurrency,
} from '../lib/snapshot';

interface Props {
  slug: string;
  name: string;
  nameEn?: string;
  ticker?: string;
  country?: string;
  segment: string;
  moat?: string;
  href: string;
}

const { slug, name, nameEn, ticker, country, segment, moat, href } = Astro.props as Props;
const stock = getStock(slug);
const change = stock ? changePct(stock) : null;
const pos = stock ? rangePosition(stock) : null;
---

<a href={href} class="company-card group">
  <div class="company-card-row1">
    <div class="min-w-0">
      <h3 class="company-card-name">{name}</h3>
      {nameEn && <p class="company-card-en">{nameEn}</p>}
    </div>
    {(ticker ?? stock?.ticker) && (
      <span class="company-card-ticker">{ticker ?? stock?.ticker}</span>
    )}
  </div>

  {stock ? (
    <div class="company-card-stock">
      <div class="company-card-price-row">
        <span class="company-card-price">{formatCurrency(stock.price, stock.currency)}</span>
        {change !== null && (
          <span class={`company-card-change ${change >= 0 ? 'is-up' : 'is-down'}`}>
            {change >= 0 ? '+' : ''}{change.toFixed(2)}%
          </span>
        )}
      </div>
      <div class="company-card-stats">
        <span><em>Fwd PE</em>{stock.forwardPE ? stock.forwardPE.toFixed(1) : '—'}</span>
        <span><em>52w</em>
          {stock.fiftyTwoWeekHigh > 0
            ? `${(((stock.price - stock.fiftyTwoWeekHigh) / stock.fiftyTwoWeekHigh) * 100).toFixed(1)}%`
            : '—'}
        </span>
      </div>
      {pos !== null && (
        <div class="company-card-rangebar" title={`52w 区间位置 ${pos.toFixed(0)}%`}>
          <div class="company-card-rangebar-fill" style={`width: ${pos}%`}></div>
        </div>
      )}
    </div>
  ) : (
    <div class="company-card-stock company-card-stock-empty">
      <span class="text-xs text-slate-400 dark:text-slate-500">暂无快照</span>
    </div>
  )}

  <div class="company-card-tags">
    <span class="company-card-segment">{segment}</span>
    {country && <span class="company-card-country">{country}</span>}
  </div>

  {moat && (
    <p class="company-card-moat">
      <span class="company-card-moat-label">护城河</span>{moat}
    </p>
  )}
</a>
