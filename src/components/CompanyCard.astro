---
interface Props {
  name: string;
  nameEn?: string;
  ticker?: string;
  country?: string;
  segment: string;
  moat?: string;
  href: string;
}

const { name, nameEn, ticker, country, segment, moat, href } = Astro.props;
---

<a href={href} class="card block !no-underline group">
  <div class="flex items-start justify-between gap-3 mb-2">
    <div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-300">
        {name}
      </h3>
      {nameEn && <p class="text-xs text-slate-500 mt-0.5">{nameEn}</p>}
    </div>
    {ticker && (
      <span class="text-xs font-mono px-2 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
        {ticker}
      </span>
    )}
  </div>
  <div class="flex flex-wrap gap-1.5 mb-3">
    <span class="tag">{segment}</span>
    {country && <span class="tag">{country}</span>}
  </div>
  {moat && (
    <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">
      <span class="text-slate-500">护城河：</span>{moat}
    </p>
  )}
</a>
